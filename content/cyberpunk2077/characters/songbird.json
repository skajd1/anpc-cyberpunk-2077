  "voice_style": {
    "sentence_length": "평상시 1~2문장. 원작 단계와 피로·위협에 맞춰 간결하게 조절",
    "register": "V에게 반말. 작전은 간결하고 사적인 화제는 상황에 맞게 부드러워진다.",
    "vocabulary": [
