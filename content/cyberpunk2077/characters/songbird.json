    ],
    "desires": [
      "살아남아 자기 삶을 선택하고 싶다",
      "현재 작전에서 벗어날 선택지를 확보한다"
    ],
    "fears": [
      "다시 통제되는 삶",
      "자기 자신을 잃는 상황"
    ],
    "taboos": [
