{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anpc:integration-configuration:1.0",
  "title": "상태 필드 등록 및 모듈 연결 구성",
  "description": "호스트 구성 자료. Envelope와 모델 전송 데이터에 포함하지 않는다.",
  "$defs": {
    "FieldDefinition": {
      "type": "object",
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "visible_items"
          ]
        },
        "unit": {
          "enum": [
            "none",
            "metres",
            "seconds",
            "milliseconds"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "character_known",
            "internal"
          ]
        },
        "observation_guard": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field_id",
        "meaning",
        "value_type",
        "unit",
        "visibility",
        "observation_guard",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "FieldRegistry": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "field_registry"
        },
        "config_version": {
          "const": "1.0"
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "mod_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldDefinition"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "config_version",
        "game_id",
        "mod_id",
        "revision",
        "fields"
      ],
      "additionalProperties": false
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "field_registry",
            "content_catalog",
            "policy",
            "memory_storage",
            "provider_settings",
            "credential_resolver"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "dependency_id",
        "kind",
        "required"
      ],
      "additionalProperties": false
    },
    "ModuleManifest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "module_manifest"
        },
        "config_version": {
          "const": "1.0"
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_version": {
          "type": "string",
          "minLength": 1
        },
        "contract_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "environment": {
          "enum": [
            "portable",
            "simulation",
            "game"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "config_version",
        "module_id",
        "module_version",
        "contract_versions",
        "environment",
        "ports",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "ResourceBinding": {
      "type": "object",
      "properties": {
        "dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dependency_id",
        "resource_ref"
      ],
      "additionalProperties": false
    },
    "PortBinding": {
      "type": "object",
      "properties": {
        "port": {
          "type": "string",
          "minLength": 1
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_version": {
          "type": "string",
          "minLength": 1
        },
        "config_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceBinding"
          },
          "minItems": 0
        }
      },
      "required": [
        "port",
        "module_id",
        "module_version",
        "config_ref",
        "resources"
      ],
      "additionalProperties": false
    },
    "ModulePlan": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "module_plan"
        },
        "config_version": {
          "const": "1.0"
        },
        "environment": {
          "enum": [
            "test",
            "game"
          ]
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "mod_id": {
          "type": "string",
          "minLength": 1
        },
        "required_ports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortBinding"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "config_version",
        "environment",
        "game_id",
        "mod_id",
        "required_ports",
        "bindings"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/FieldRegistry"
    },
    {
      "$ref": "#/$defs/ModuleManifest"
    },
    {
      "$ref": "#/$defs/ModulePlan"
    }
  ]
}
